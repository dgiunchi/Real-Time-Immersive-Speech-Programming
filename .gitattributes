# Normalize line endings; let Git detect text vs binary.
* text=auto eol=lf

# Windows-oriented helper stays CRLF-friendly on checkout if edited on Windows.
*.ps1 text eol=crlf

# Explicit text types.
*.rs   text
*.cs   text
*.py   text
*.sh   text eol=lf
*.toml text
*.md   text
*.json text
*.html text

# Cargo.lock is generated but committed for reproducibility; mark as generated for quieter diffs.
Cargo.lock linguist-generated=true

# Unity script meta files: text, but exclude from language stats.
*.meta text linguist-generated=true

# Treat common binaries as binary (none should be committed, but be safe).
*.png binary
*.jpg binary
*.dll binary
*.pdb binary
