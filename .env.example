# DreamCodeVR+ backend configuration — copy to `.env` (which is gitignored).
#
# The server reads these from the process environment. NEVER commit real keys or
# real network addresses. With STT URL / OpenAI key UNSET, the backend uses the
# offline MOCK clients, so the whole pipeline runs locally with no credentials.
# Uncommented lines below are safe defaults; commented lines are optional/opt-in.
# Boolean flags accept true/TRUE/1/yes (any case, whitespace-tolerant); anything
# else is false.

# ===================== Core runtime =====================
DCVR_MODE=action_plan_fast            # execution mode (Mode C bounded action plan)

# ===================== Networking =======================
# Standalone TCP listener (used when NOT joining a Ubiq room):
#   backend + client on one machine -> 127.0.0.1:9098 (default)
#   a real headset on the same Wi-Fi must use the computer's LAN IP, not 127.0.0.1
#   (example, documentation-reserved range only): e.g. 192.0.2.10:9098
DCVR_LISTEN_ADDR=127.0.0.1:9098
# Ubiq SERVICE-PEER mode: join a RoomServer instead of the standalone listener.
# DCVR_UBIQ_ADDR=127.0.0.1:8009        # RoomServer host:port reachable from this machine
# DCVR_ROOM_GUID=<ubiq-room-guid>      # a demo default ships in code; override per deployment
# Helper scripts (scripts/uni-day.sh, scripts/keep-alias.sh) read DCVR_ROOMSERVER_HOST
# and DCVR_ALIAS_IP for LAN setup — see docs/BUILD_AND_RUN.md. No address is baked in.

# ===================== Admin / debug panel (optional) ===
# DCVR_ADMIN_PORT=7878                 # serve the dashboard on http://127.0.0.1:7878 (loopback)
# DCVR_ADMIN_TOKEN=change-me           # require X-Admin-Token for mutating routes.
#                                      # REQUIRED if you ever bind off loopback (do not expose publicly).

# ===================== STT (speech-to-text) =============
# Unset = mock STT (treats NID 98 bytes as text). Options for real STT:
# DCVR_STT_HTTP_URL=http://YOUR-FASTER-WHISPER-HOST:50101/stt/transcribe
# DCVR_STT_OPENAI=true                 # use OpenAI Whisper instead (reuses OPENAI_API_KEY)
# OPENAI_STT_MODEL=whisper-1           # or gpt-4o-mini-transcribe (faster)
DCVR_STT_TIMEOUT_MS=10000

# ===================== LLM ==============================
# Unset OPENAI_API_KEY = mock LLM (deterministic offline plans; no cost).
# OPENAI_API_KEY=sk-...                # SECRET; never commit. Enables the real LLM path.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for OpenAI-compatible servers
DCVR_LLM_TIMEOUT_MS=60000              # code default; raise (e.g. 180000) for large Mode-A/B builds

# ===================== Roslyn analyzer (Mode B, optional)
# DCVR_CSHARP_RESEARCH=true            # dev/research only: route NID 98 through validated C#
# DCVR_ROSLYN_URL=http://127.0.0.1:5099/analyze   # deeper .NET semantic check (mock if unset)

# ===================== Sandbox (Mode D, optional) =======
# DCVR_SANDBOX_DOCKER_RUNTIME=runsc    # run the Mode-D sandbox under gVisor (else Docker runc).
#                                      # Requires runsc installed + registered with Docker.

# ===================== Security (opt-in; OFF by default)
# Mode A: send VALIDATED generated C# to the original Unity CodeGenerationManager
# (NID 94) for runtime RoslynCSharp compilation. Widens the trust surface.
# DCVR_MODE_A=true
# Per-peer admission token (defence vs Man-in-the-Room). NOTE: the HMAC module exists
# but is not fully wired into the live path in this release (see docs/LIMITATIONS.md).
# DCVR_REQUIRE_PEER_AUTH=true
# DCVR_PEER_AUTH_SECRET=change-me       # shared HMAC secret (env-only; NEVER commit a real value)
# Perceptual/comfort hardening: ALSO ban the perceptual-attack C# surface (Mode B).
# DCVR_PERCEPTUAL_HARDENING=true
# DCVR_PERSONAL_SPACE_RADIUS_M=0.5
# DCVR_COMFORT_ROTATE_MAX_DEG_S=90
# DCVR_MIN_PLAN_INTERVAL_MS=250
# DCVR_MAX_GENERATIONS_PER_MIN=30

# ===================== Personalization / RAG (optional) =
# DCVR_PERSONALIZATION_DIR=.dcvr-data/personalization   # local JSON store (gitignored)
# DCVR_EMBED_OPENAI=true               # use OpenAI embeddings for RAG (else local mock)

# ===================== Observability ====================
# Telemetry is built-in, privacy-safe JSONL (ids/timestamps/decisions/reason-codes —
# never audio/transcripts/secrets). No environment variable is required.
