{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "rootDir": "./",
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "ubiq-server/ubiq": ["node_modules/ubiq-server/ubiq/index.ts"],
      "ubiq-server/ubiq/*": ["node_modules/ubiq-server/ubiq/*"],
      "ubiq-server/components": ["node_modules/ubiq-server/components/index.ts"],
      "ubiq-server/components/*": ["node_modules/ubiq-server/components/*"],
      "modules": ["node_modules/ubiq-server/modules/index.ts"],
      "modules/*": ["node_modules/ubiq-server/modules/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["dist", "node_modules"],
  "ts-node": {
    "compilerOptions": {
      "module": "NodeNext",
      "moduleResolution": "NodeNext"
    },
    "esm": true,
    "experimentalSpecifierResolution": "node",
    "transpileOnly": true,
    "ignore": ["(?:^|[\\\\/])node_modules[\\\\/](?!ubiq-server[\\\\/])"]
  }
}
