#!/bin/bash
# Launch the study from anywhere.
#
#   ./study            ask which mode
#   ./study demo       film
#   ./study study      run a participant
#   ./study pull       copy demo clips off the headset
#
# Exists because the real command lived two directories down, which meant
# remembering to cd first and getting an error if you were anywhere else.
# Resolves its own location, so it does not care where you run it from.

set -e
cd "$(dirname "${BASH_SOURCE[0]}")/Server"

# node directly rather than through npm: npm prints two lines of its own before
# anything happens, and the first thing on screen should be the mode question.
case "${1:-}" in
  demo)   exec node scripts/study.js --demo  ;;
  study)  exec node scripts/study.js --study ;;
  "")     exec node scripts/study.js         ;;
  *)
    echo "Usage:  study            ask which mode"
    echo "        study demo       go straight to filming"
    echo "        study study      go straight to a participant session"
    exit 1
    ;;
esac
